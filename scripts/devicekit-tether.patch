+
+/// Tether: lets the iPhone app turn control off. Answers first, then ends
+/// the runner, which also ends `xcodebuild test` on the Mac.
+@MainActor
+struct StopMethodHandler: RPCMethodHandler {
+    static let methodName = "device.stop"
+
+    private let logger = Logger(
+        subsystem: Bundle.main.bundleIdentifier!,
+        category: String(describing: Self.self)
+    )
+
+    func execute(params: JSONValue?) async throws -> JSONValue {
+        logger.info("Stop requested from the iPhone")
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.3) {
+            exit(0)
+        }
+        return .object(["success": .bool(true)])
+    }
+}
