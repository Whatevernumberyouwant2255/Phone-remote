    },
    "Your iPhone and Apple Vision Pro need to be on the same Wi-Fi network.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre iPhone et votre Apple Vision Pro doivent être sur le même réseau Wi-Fi."
          }
        }
      }
    },
    "Your iPhone and Mac need to be on the same Wi-Fi network.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre iPhone et votre Mac doivent être sur le même réseau Wi-Fi."
          }
        }
      }
    },
    "Your iPhone screen, in a window on Apple Vision Pro or Mac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écran de votre iPhone, dans une fenêtre sur l’Apple Vision Pro ou le Mac."
          }
        }
      }
    },
    "Your screen goes straight from your iPhone to your Vision Pro or Mac over your local network, encrypted with your pairing code. Nothing is sent to the internet or collected.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre écran passe directement de votre iPhone à votre Vision Pro ou votre Mac par votre réseau local, chiffré avec votre code de jumelage. Rien n’est envoyé sur Internet ni collecté."
          }
        }
      }
    },
    "iPhone": {
      "shouldTranslate": false
    },
    "Phone Remote": {
      "shouldTranslate": false
    },
    "Phone Remote can't use the network right now: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
