      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Phone Remote sur votre Apple Vision Pro ou votre Mac. Il apparaît ci-dessous quand les deux appareils sont sur le même réseau Wi-Fi."
