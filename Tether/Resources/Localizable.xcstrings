      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moyen"
          }
        }
      }
    },
    "Mirroring goes to whichever device has Phone Remote open. If both are open, the one you used last.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recopie va vers l’appareil où Phone Remote est ouvert. Si les deux le sont, vers le dernier utilisé."
          }
        }
      }
    },
    "Mirroring was stopped from Apple Vision Pro.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recopie a été arrêtée depuis l’Apple Vision Pro."
          }
        }
      }
    },
    "Mirroring works. Controlling the iPhone needs a one-time developer setup with a Mac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recopie fonctionne. Contrôler l’iPhone nécessite une configuration développeur unique avec un Mac."
          }
        }
      }
    },
    "New Code": {
      "localizations": {
        "fr": {
