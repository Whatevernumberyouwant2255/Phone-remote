{
  "sourceLanguage": "en",
  "strings": {
    "%@ is paired. Tap Start Mirroring on it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est jumelé. Touchez « Lancer la recopie » dessus."
          }
        }
      }
    },
    "%lld": {
      "shouldTranslate": false
    },
    "ABCD-2345": {
      "shouldTranslate": false
    },
    "Actual Size": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille réelle"
          }
        }
      }
    },
    "App Switcher": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélecteur d’apps"
          }
        }
      }
    },
    "App Switcher (⌘2)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélecteur d’apps (⌘2)"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        }
      }
    },
    "Choose **%@** and enter this code:": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez **%@** et saisissez ce code :"
          }
        }
      }
    },
    "Connecting to %@…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion à %@…"
          }
        }
      }
    },
    "Control could not start. Connect and unlock the iPhone, then try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôle n’a pas pu démarrer. Connectez et déverrouillez l’iPhone, puis réessayez."
          }
        }
      }
    },
    "Control off": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle désactivé"
          }
        }
      }
    },
    "Control stopped. Is the iPhone still connected and unlocked?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôle s’est arrêté. L’iPhone est-il toujours connecté et déverrouillé ?"
          }
        }
      }
    },
    "Control:": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle :"
          }
        }
      }
    },
    "Couldn't reach %@. Open Phone Remote on it and make sure both devices are on the same Wi-Fi network.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre %@. Ouvrez Phone Remote dessus et vérifiez que les deux appareils sont sur le même réseau Wi-Fi."
          }
        }
      }
    },
    "Couldn't reach that device. Keep Phone Remote open on it and make sure both devices are on the same Wi-Fi network.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre cet appareil. Laissez Phone Remote ouvert dessus et vérifiez que les deux appareils sont sur le même réseau Wi-Fi."
          }
        }
      }
    },
    "Create a new code?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créer un nouveau code ?"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Enter the code shown in Phone Remote on %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le code affiché dans Phone Remote sur %@."
          }
        }
      }
    },
    "Enter this code in Phone Remote on another iPhone to pair it with %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez ce code dans Phone Remote sur un autre iPhone pour le jumeler avec %@."
          }
        }
      }
    },
    "Every paired iPhone will need to pair again. Any current mirroring stops.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque iPhone jumelé devra être jumelé à nouveau. La recopie en cours s’arrête."
          }
        }
      }
    },
    "Forget This Device": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublier cet appareil"
          }
        }
      }
    },
    "Go to the iPhone's Home Screen": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenir à l’écran d’accueil de l’iPhone"
          }
        }
      }
    },
    "Go to the iPhone's Home Screen (⌘1)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenir à l’écran d’accueil de l’iPhone (⌘1)"
