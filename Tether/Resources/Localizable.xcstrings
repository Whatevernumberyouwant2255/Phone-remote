    "Phone Remote is open": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone Remote est ouvert"
          }
        }
      }
    },
    "Phone Remote needs Local Network access to find your devices. Turn it on in Settings › Privacy & Security › Local Network.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone Remote a besoin de l’accès au réseau local pour trouver vos appareils. Activez-le dans Réglages › Confidentialité et sécurité › Réseau local."
