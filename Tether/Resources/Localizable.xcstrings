    "Tap a text field on the iPhone first, then type here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez d’abord un champ de texte sur l’iPhone, puis écrivez ici."
          }
        }
      }
    },
    "Tap and swipe from your Vision Pro or Mac. Your iPhone stays awake while mirroring.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez et balayez depuis votre Vision Pro ou votre Mac. Votre iPhone reste allumé pendant la recopie."
