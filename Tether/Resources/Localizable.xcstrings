    "Home": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accueil"
          }
        }
      }
    },
    "Install Phone Remote on your iPhone and open it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez Phone Remote sur votre iPhone et ouvrez-le."
          }
