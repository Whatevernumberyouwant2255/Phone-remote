        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver le contrôle"
          }
        }
      }
    },
    "This version of the control helper can't be stopped from the iPhone. Quit Phone Remote on the Mac, or stop the script there.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de l’outil de contrôle ne peut pas être arrêtée depuis l’iPhone. Quittez Phone Remote sur le Mac ou arrêtez-y le script."
